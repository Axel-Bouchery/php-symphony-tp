{% extends 'base.html.twig' %}

{% block title %}Ajouter un restaurant{% endblock %}

{% block body %}

    <h1>Ajouter un restaurant</h1>

    {{ form_start(form) }}

        {{ form_row(form.nom) }}
        {{ form_row(form.description) }}
        {{ form_row(form.rating) }}
        {{ form_row(form.ville) }}

        <button type="submit">Ajouter</button>

    {{ form_end(form) }}

{% endblock %}