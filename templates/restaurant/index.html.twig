{% extends 'base.html.twig' %}

{% block title %}Restaurants{% endblock %}

{% block body %}
    <h1>Restaurants</h1>

    {% if is_granted('ROLE_USER') %}
        <p>
            <a href="{{ path('app_restaurant_new') }}">Ajouter un restaurant</a>
        </p>
    {% endif %}

    {% if restaurants is empty %}
        <p>Aucun restaurant enregistré.</p>
    {% else %}
        <ul>
            {% for restaurant in restaurants %}
                <li>
                    <strong>{{ restaurant.nom }}</strong>

                    {% if restaurant.description %}
                        - {{ restaurant.description }}
                    {% endif %}

                    {% if restaurant.rating %}
                        - Note : {{ restaurant.rating }}/5
                    {% endif %}

                    {% if restaurant.ville %}
                        - Ville : {{ restaurant.ville.nom }}
                    {% endif %}

                    {% if is_granted('ROLE_USER') %}
                        <a href="{{ path('app_restaurant_edit', {id: restaurant.id}) }}">
                            Modifier
                        </a>
                    {% endif %}

                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_restaurant_delete', {id: restaurant.id}) }}">
                            Supprimer
                        </a>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
