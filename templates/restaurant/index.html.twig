{% extends 'base.html.twig' %}

{% block title %}Hello RestaurantController!{% endblock %}

{% block body %}

    <h1>Restaurants</h1>

    <form method="get" action="{{ path('app_restaurant') }}">
        <label for="ville">Ville :</label>
        <input type="text" name="ville" id="ville">
        <button type="submit">Filtrer</button>
    </form>


    {% for restaurant in restaurants %}
        <div>
            <h2>{{ restaurant.nom }}</h2>

            <p>{{ restaurant.description }}</p>

            <p>Rating : {{ restaurant.rating }}/5</p>

            <p>Ville : {{ restaurant.ville.nom }}</p>

            <a href="{{ path('app_restaurant_show', {id: restaurant.id}) }}">
                Voir
            </a>

            <a href="{{ path('app_restaurant_edit', {id: restaurant.id}) }}">
                Modifier
            </a>

            <a href="{{ path('app_restaurant_delete', {id: restaurant.id}) }}"
                onclick="return confirm('Voulez-vous vraiment supprimer ce restaurant ?');">
                Supprimer
            </a>


        </div>

        <hr>
    {% else %}
        <p>Aucun restaurant trouvé.</p>
    {% endfor %}

{% endblock %}