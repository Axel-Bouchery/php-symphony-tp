{% extends 'base.html.twig' %}

{% block title %}Commentaires{% endblock %}

{% block body %}
    <h1>Commentaires</h1>

    {% if is_granted('ROLE_USER') %}
        <p>
            <a href="{{ path('app_commentaire_new') }}">Ajouter un commentaire</a>
        </p>
    {% endif %}

    {% if commentaires is empty %}
        <p>Aucun commentaire enregistré.</p>
    {% else %}
        <ul>
            {% for commentaire in commentaires %}
                <li>
                    <strong>{{ commentaire.user.email }}</strong>
                    - {{ commentaire.contenu }}
                    - Note : {{ commentaire.note }}/5

                    {% if is_granted('ROLE_ADMIN') or commentaire.user == app.user %}
                        <a href="{{ path('app_commentaire_delete', {id: commentaire.id}) }}">
                            Supprimer
                        </a>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
